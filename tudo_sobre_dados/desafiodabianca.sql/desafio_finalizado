--Nível 4: Avançado (Múltiplos JOINs + GROUP BY + Agregação)

--Exercício 4.1 crie um relatório de desempenho por instrutor:
--Nome do instrutor
--Quantidade de cursos criados
---Total de alunos matriculados em seus cursos (contar apenas alunos distintos)
--Média de avaliações recebidas
--Quantidade de matrículas concluídas
--Ordene pelo maior número de alunos.
SELECT 
    u.nome_completo AS instrutor,
    
    -- Quantidade de cursos criados
    COUNT(DISTINCT c.id_curso) AS qtd_cursos,
    
    -- Total de alunos distintos matriculados nesses cursos
    COUNT(DISTINCT m.id_aluno) AS total_alunos,
    
    -- Média das avaliações recebidas (somente notas não nulas)
    AVG(m.nota_final) AS media_avaliacoes,
    
    -- Quantidade de matrículas concluídas
    SUM(CASE WHEN m.status = 'CONCLUIDA' THEN 1 ELSE 0 END) AS qtd_concluidas

FROM escola_online.usuario u
JOIN escola_online.curso c
    ON c.id_instrutor = u.id_usuario
LEFT JOIN escola_online.matricula m
    ON m.id_curso = c.id_curso

WHERE u.nome_completo ILIKE '%instrutor'
GROUP BY u.nome_completo 
ORDER BY total_alunos DESC;

