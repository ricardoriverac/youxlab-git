    c.titulo AS curso,
    m.data_matricula,
    COUNT(a.id_aula) AS total_aulas,
    COUNT(pa.id_progresso) AS aulas_concluidas,
    (COUNT(pa.id_progresso)::float / COUNT(a.id_aula) * 100) AS percentual
FROM
	escola_online.matricula m
JOIN 
	escola_online.usuario u ON u.id_usuario = m.id_aluno
JOIN 
	escola_online.curso c ON c.id_curso = m.id_curso
JOIN 
	escola_online.modulo mo ON mo.id_curso = c.id_curso
JOIN 
	escola_online.aula a ON a.id_modulo = mo.id_modulo
LEFT JOIN 
	escola_online.progresso_aula pa
    ON pa.id_aula = a.id_aula
    AND pa.id_matricula = m.id_matricula
    AND pa.concluida = true
WHERE m.status = 'ATIVA'
GROUP BY u.nome_completo, c.titulo, m.data_matricula
ORDER BY percentual ASC;
-- PRA BAIXO ESTAO FUNCIONANDO
--Exercício 4.5
--Liste cursos com baixo engajamento:
--Título do curso
--Nome do instrutor
--Total de matrículas
--Quantidade de matrículas com status CANCELADA
--Média de avaliações (entre 1 e 5)
--Percentual de cancelamento
--Mostre apenas cursos com mais de 1 matrícula. Ordene pelo percentual de cancelamento (descrescente).
SELECT
    c.titulo AS curso,
    u.nome_completo AS instrutor,
    COUNT(m.id_matricula) AS total_matriculas,
    SUM(CASE WHEN m.status = 'CANCELADA' THEN 1 ELSE 0 END) AS canceladas,
    AVG(a.id_avaliacao) AS media_avaliacoes,
    (SUM(CASE WHEN m.status = 'CANCELADA' THEN 1 ELSE 0 END) * 1.0 
        / COUNT(m.id_matricula) * 100) AS percentual_cancelamento
FROM escola_online.curso c
JOIN escola_online.usuario u
    ON u.id_usuario = c.id_instrutor
JOIN escola_online.matricula m
    ON m.id_curso = c.id_curso
LEFT JOIN escola_online.avaliacao_curso a
    ON a.id_matricula = m.id_matricula
GROUP BY
    c.titulo,
    u.nome_completo
HAVING COUNT(m.id_matricula) > 1
ORDER BY percentual_cancelamento DESC;





---Exercício 4.6
--Crie um relatório de progresso geral por curso:
--Título do curso
--Total de aulas
--Total de registros de progresso (alunos × aulas)
--Quantidade de registros concluídos
--Percentual geral de conclusão
SELECT
    c.titulo AS curso,
    COUNT(a.id_aula) AS total_aulas,
    COUNT(p.id_progresso) AS total_registros,
    SUM(CASE WHEN p.concluida = true THEN 1 ELSE 0 END) AS concluidos,
    (SUM(CASE WHEN p.concluida = true THEN 1 ELSE 0 END) * 1.0
        / NULLIF(COUNT(p.id_progresso), 0) * 100) AS percentual_conclusao
FROM escola_online.curso c
JOIN escola_online.modulo m
    ON m.id_curso = c.id_curso
JOIN escola_online.aula a
    ON a.id_modulo = m.id_modulo
LEFT JOIN escola_online.progresso_aula p
    ON p.id_aula = a.id_aula
GROUP BY c.titulo;

--Exercício 4.7
--Análise de avaliações:
--Título do curso
--Nome do instrutor
--Quantidade de avaliações recebidas
--Nota mínima, máxima e média
--Quantidade de avaliações com nota ≥ 4
--Quantidade de avaliações com nota < 4
--Ordene pela média de avaliações (descendente).
SELECT
    c.titulo AS curso,
    u.nome_completo AS instrutor,
    COUNT(ac.id_avaliacao) AS qtd_avaliacoes,
    MIN(ac.nota) AS nota_minima,
    MAX(ac.nota) AS nota_maxima,
    AVG(ac.nota) AS nota_media,
    SUM(CASE WHEN ac.nota >= 4 THEN 1 ELSE 0 END) AS boas_avaliacoes,
    SUM(CASE WHEN ac.nota < 4  THEN 1 ELSE 0 END) AS ruins_avaliacoes
FROM escola_online.curso c
JOIN escola_online.usuario u
    ON u.id_usuario = c.id_instrutor
LEFT JOIN escola_online.avaliacao_curso ac
    ON c.id_curso = c.id_curso
GROUP BY
    c.titulo,
    u.nome_completo
ORDER BY nota_media DESC;

--Exercício 4.8
--Relatório de alunos inativos:
--Nome do aluno
--Quantidade de matrículas ativas
--Última data de atividade em progresso_aula
--Dias desde a última atividade
--Mostre apenas alunos com matrículas ativas há mais de 7 dias sem atividade.
SELECT
    u.nome_completo AS aluno,
    COUNT(m.id_matricula) AS matriculas_ativas,
    MAX(p.data_ultima_acao) AS ultima_atividade,
    CURRENT_DATE - MAX(p.data_ultima_acao)::date AS dias_inativo
FROM escola_online.usuario u
JOIN escola_online.matricula m
    ON m.id_aluno = u.id_usuario
    AND m.status = 'ATIVA'
LEFT JOIN escola_online.progresso_aula p
    ON p.id_matricula = m.id_matricula
GROUP BY u.nome_completo
HAVING 
    COUNT(m.id_matricula) > 0                            -- tem matricula ativa
    AND (CURRENT_DATE - MAX(p.data_ultima_acao)::date) > 7  -- mais de 7 dias parado
ORDER BY dias_inativo DESC;


--Exercício 4.9
--Comparação entre cursos do mesmo instrutor:
--Nome do instrutor
--Título do curso
--Quantidade de alunos matriculados
--Média de avaliações
--Status do curso (PUBLICADO ou RASCUNHO)
--Mostre instrutores com mais de um curso e ordene por instrutor, depois por quantidade de alunos.
SELECT
    u.nome_completo AS instrutor,
    c.titulo AS curso,
    COUNT(m.id_matricula) AS alunos_matriculados,
    AVG(ac.nota) AS media_avaliacoes,
    m.status AS status_curso
FROM escola_online.curso c
JOIN escola_online.usuario u
    ON u.id_usuario = c.id_instrutor
LEFT JOIN escola_online.matricula m
    ON m.id_curso = c.id_curso
LEFT JOIN escola_online.avaliacao_curso ac
    ON c.id_curso = c.id_curso
WHERE c.id_instrutor IN (
    SELECT id_instrutor
    FROM escola_online.curso
    GROUP BY id_instrutor
    HAVING COUNT(*) > 1     -- instrutor com mais de 1 curso
)
GROUP BY
    u.id_usuario,
    u.nome_completo,
    c.id_curso,
    c.titulo,
    m.status
ORDER BY
    instrutor,
    alunos_matriculados DESC;


