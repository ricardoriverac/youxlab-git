-- 33. O nome do livro, a categoria e a editora (LIVRO) – fazer uma view
create view livro_informacoes as
select 
	lv.nome as livro, 
	ctg.nome as categoria, 
	edt.nome
from livro lv
left outer join
	categoria ctg on lv.idcategoria = ctg.idcategoria
left outer join
	editora edt on lv.ideditora = edt.ideditora
select * from livro_informacoes

-- 34. O nome do livro e o nome do autor (LIVRO_AUTOR) – fazer uma view.
create view livro_autor_informacoes as
select 
	lv.nome as livro,
	atr.nome as autor
from livro_autor lva
left outer join
	livro lv on lva.idlivro = lv.idlivro
left outer join
	autor atr on lva.idautor = atr.idautor
	
