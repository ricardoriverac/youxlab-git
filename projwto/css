:root {
  --primary: #2b6cb0;
  --bg: #f7fafc;
  --card: #ffffff;
}

body {
  font-family: Inter, system-ui, -apple-system, Roboto, "Segoe UI", Arial;
  background: var(--bg);
  margin: 0;
  padding: 20px;
  color: #1a202c;
}

.container {
  max-width: 800px;
  margin: 20px auto;
  padding: 20px;
  background: var(--card);
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
}

h1 {
  margin: 0 0 8px;
  font-size: 1.6rem;
}

p.lead {
  margin: 0 0 16px;
  color: #4a5568;
}

label {
  display: block;
  font-weight: 600;
  margin-top: 12px;
}

input[type=text],
input[type=datetime-local],
textarea,
select {
  width: 100%;
  padding: 10px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  margin-top: 6px;
  font-size: 0.95rem;
}

textarea {
  min-height: 100px
}